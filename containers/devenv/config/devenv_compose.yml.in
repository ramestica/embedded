services:
  devenv:
    image: devenv:latest
    container_name: devenv-${USER}
    hostname: devenv
    build:
      context: @CMAKE_BINARY_DIR@
      dockerfile: @CMAKE_BINARY_DIR@/config/Dockerfile.devenv
      platforms:
        - @DEVENV_TARGET_PLATFORM@
    ports:
      - "${SSH_USER_PORT}:22"
    environment:
      HOST_USER: "${USER}"
      HOST_UID:  "${UID}"
      HOST_GID:  "${GID}"
      USER_SANDBOX: "${USER_SANDBOX}"
    volumes:
      - "${HOME}/.ssh:/home/${USER}/.ssh:ro"
      - "/Users/ramestica/src/github/ramestica/embedded/build/Release/.known_hosts:/home/${USER}/.ssh/known_hosts"
      - "${USER_SANDBOX}:/home/${USER}/sandbox"
    restart: unless-stopped

