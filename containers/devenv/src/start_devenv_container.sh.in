if [ -z "${UID:-}" ]; then
    UID=$(id -u)
fi

if [ -z "${GID:-}" ]; then
    GID=$(id -g)
fi

export UID GID
export USER_SANDBOX="$HOME/src"

declare -A ssh_ports
ssh_ports[ramestica]=8022

if [[ ! -v ssh_ports[$USER] ]]; then
    echo "user=$USER not mapped to a ssh port number"
    exit 1
fi

export SSH_USER_PORT=${ssh_ports[$USER]}

docker compose -f @EMB_CONFIG_DIR@/devenv_compose.yml up --build -d

